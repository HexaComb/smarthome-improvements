---
import { reviews, site } from '../data/site';
import Icon from './Icon.astro';
import SectionHead from './SectionHead.astro';
interface Props {
  /** Zero-padded sheet number passed through to SectionHead (home uses "05"). */
  no?: string;
}
const { no } = Astro.props;
// Quote cards stay hidden until real Google review text replaces the
// placeholders in site.ts (never present invented quotes as reviews).
const SHOW_QUOTES = false;
const r = site.rating;
---

<section class="section bg-navy-50 bg-blueprint-light">
  <div class="container-x">
    <SectionHead no={no} kicker="Trusted by Central Valley homeowners" title="What our customers say" />
    <a
      href={r.url}
      target="_blank"
      rel="noopener"
      class="mt-5 inline-flex items-center gap-3 border border-navy-600/25 bg-white px-5 py-2.5 transition hover:border-navy-600/50"
    >
      <span class="font-display num text-2xl font-bold text-navy-700">{r.value}</span>
      <span class="flex text-orange-500" aria-hidden="true">
        {Array.from({ length: 5 }).map(() => <Icon name="star" class="h-5 w-5" />)}
      </span>
      <span class="num text-sm font-medium text-slate-600">{r.count} Google reviews</span>
    </a>
    {SHOW_QUOTES && (
    <div class="mt-12 grid gap-6 md:grid-cols-3" data-stagger>
      {
        reviews.map((r) => (
          <figure class="flex flex-col rounded-none border border-navy-600/20 bg-white p-6">
            <p class="spec-tag-ghost kicker text-navy-500">Google review · {r.city}</p>
            <div class="mt-3 flex text-orange-500" role="img" aria-label={`${r.rating} out of 5 stars`}>
              {Array.from({ length: r.rating }).map(() => (
                <Icon name="star" class="h-5 w-5" />
              ))}
            </div>
            <blockquote class="mt-4 flex-1 text-slate-700">“{r.text}”</blockquote>
            <figcaption class="mt-4 text-sm font-semibold text-navy-900">
              {r.name}
              <span class="font-normal text-slate-500">, {r.city}</span>
            </figcaption>
          </figure>
        ))
      }
    </div>
    )}
  </div>
</section>
