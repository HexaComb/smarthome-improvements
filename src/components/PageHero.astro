---
import Breadcrumbs from './Breadcrumbs.astro';
import Icon from './Icon.astro';
import { webpSrcset, cardSrcset } from '../lib/images';
interface Props {
  /** Background photo. Optional when `illustration` is set (the photo never renders then). */
  image?: string;
  imageAlt?: string;
  /** Optional isometric illustration (SVG path). Renders on the right with content on the left. */
  illustration?: string;
  kicker?: string;
  title: string;
  intro?: string;
  crumbs?: { name: string; path: string }[];
  bullets?: string[];
  size?: 'sm' | 'lg';
  eager?: boolean;
  /** Optional sheet number for the title block row, e.g. '01'. */
  sheetNo?: string;
  /** Optional FIG plate caption for the illustration variant (falls back to imageAlt). */
  figLabel?: string;
}
const {
  image,
  imageAlt = '',
  illustration,
  kicker,
  title,
  intro,
  crumbs,
  bullets = [],
  size = 'sm',
  eager = false,
  sheetNo,
  figLabel,
} = Astro.props;
const hasActions = Astro.slots.has('default');
const srcset = image ? (webpSrcset(image) ?? cardSrcset(image)) : undefined;
---

<section class:list={['relative overflow-hidden bg-navy-900 text-white', illustration && 'grain bg-blueprint']}>
  {!illustration && (
    <>
      <div class="duo absolute inset-0">
        <img
          src={image}
          srcset={srcset}
          sizes={srcset ? '100vw' : undefined}
          alt={imageAlt}
          width="2000"
          height="1100"
          fetchpriority={eager ? 'high' : undefined}
          loading={eager ? 'eager' : 'lazy'}
          decoding="async"
          class="h-full w-full object-cover"
        />
      </div>
      <div class="absolute inset-0 bg-gradient-to-r from-navy-900 via-navy-900/92 to-navy-900/55"></div>
    </>
  )}
  {illustration && (
    <img src="/brand/mark-white.svg" alt="" aria-hidden="true" class="pointer-events-none absolute -right-16 top-0 hidden w-[34rem] opacity-[0.04] lg:block" />
  )}
  <div
    class:list={[
      'container-x relative',
      illustration ? 'grid items-center gap-8 lg:grid-cols-2' : '',
      size === 'lg' ? 'py-20 lg:py-28' : 'py-14 lg:py-20',
    ]}
  >
    <div>
      {crumbs && <Breadcrumbs items={crumbs} light={true} />}
      {kicker && (
        <div class="mt-5 flex items-center gap-3">
          {sheetNo && (
            <span class="sheet-no sheet-no-dark" aria-hidden="true">{sheetNo}</span>
          )}
          <p class="kicker text-navy-200">{kicker}</p>
          <span class="h-px flex-1 bg-navy-200/40" aria-hidden="true"></span>
        </div>
      )}
      <h1
        class:list={[
          crumbs || kicker ? 'mt-2' : 'mt-0',
          size === 'lg'
            ? 'h-hero'
            : 'font-display text-4xl font-bold uppercase leading-[0.95] tracking-tight sm:text-5xl',
        ]}
      >
        {title}
      </h1>
      <div class="rule-dim mt-4 w-24 text-orange-500" aria-hidden="true"></div>
      {intro && <p class="mt-5 max-w-2xl text-lg text-navy-100">{intro}</p>}
      {hasActions && (
        <div class="mt-7 flex flex-col gap-3 sm:flex-row">
          <slot />
        </div>
      )}
      {bullets.length > 0 && (
        <ul class="mt-7 flex flex-wrap gap-x-6 gap-y-2 text-sm text-navy-100">
          {bullets.map((b) => (
            <li class="flex items-center gap-2">
              <Icon name="check" class="h-4 w-4 text-orange-400" /> {b}
            </li>
          ))}
        </ul>
      )}
    </div>
    {illustration && (
      <div class="relative hidden items-center justify-center lg:flex">
        <figure class="w-full max-w-xl border border-white/15 bg-navy-950/40 p-6">
          <img src={illustration} alt={imageAlt} width="1340" height="1040" fetchpriority={eager ? 'high' : undefined} loading={eager ? 'eager' : 'lazy'} decoding="async" class="w-full" />
          <figcaption class="spec-tag mt-4">Fig. 1 <span class="text-navy-200">·</span> {figLabel ?? imageAlt}</figcaption>
        </figure>
      </div>
    )}
  </div>
</section>
