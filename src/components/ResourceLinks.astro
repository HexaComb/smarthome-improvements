---
// "Pricing and honest answers" band: links each service page down to its cost
// guide, the instant estimate tool, and the FAQ so hub-and-spoke flows both ways.
import Icon from './Icon.astro';
import { serviceResources, type ServiceSlug } from '../data/blogMeta';

interface Props {
  service: ServiceSlug;
}
const { service } = Astro.props;
const links = serviceResources[service] ?? [];
---

{
  links.length > 0 && (
    <section class="section bg-white">
      <div class="container-x">
        <p class="kicker text-orange-700">Pricing and honest answers</p>
        <h2 class="mt-2 h-section">Know what it costs before anyone visits</h2>
        <div class="mt-8 grid gap-4 sm:grid-cols-2" data-stagger>
          {links.map((l) => (
            <a href={l.href} class="group flex items-start justify-between gap-4 border border-navy-600/20 bg-white p-5 transition hover:border-navy-600/50">
              <span>
                <span class="block font-display text-lg font-bold uppercase tracking-tight text-navy-800 group-hover:text-orange-600">{l.label}</span>
                <span class="mt-1 block text-sm text-slate-600">{l.note}</span>
              </span>
              <Icon name="arrow" class="mt-1 h-5 w-5 flex-shrink-0 text-navy-300 transition group-hover:translate-x-1 group-hover:text-orange-500" />
            </a>
          ))}
        </div>
      </div>
    </section>
  )
}
