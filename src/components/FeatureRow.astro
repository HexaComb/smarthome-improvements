---
import Icon from './Icon.astro';
import { cardSrcset } from '../lib/images';
import SectionHead from './SectionHead.astro';
interface Props {
  eyebrow?: string;
  title: string;
  image: string;
  imageAlt: string;
  bullets?: string[];
  reverse?: boolean;
  tone?: 'light' | 'muted' | 'dark';
  cta?: { href: string; label: string };
  /** Render the image contained on a tinted panel (for isometric illustrations) instead of a cropped photo. */
  illustration?: boolean;
  /** Photo-log caption rendered as a spec tag butted under the image. Real data only; middle-dot separators. */
  specTag?: string;
}
const {
  eyebrow,
  title,
  image,
  imageAlt,
  bullets = [],
  reverse = false,
  tone = 'light',
  cta,
  illustration = false,
  specTag,
} = Astro.props;

const bg =
  tone === 'dark'
    ? 'bg-navy-900 bg-blueprint grain text-white'
    : tone === 'muted'
      ? 'bg-navy-50 bg-blueprint-light'
      : 'bg-white';
const titleColor = tone === 'dark' ? 'text-white' : 'text-navy-700';
const bodyColor = tone === 'dark' ? 'text-navy-100' : 'text-slate-600';
---

<section class:list={['overflow-x-clip', bg]}>
  <div class="container-x grid items-start gap-10 py-16 lg:grid-cols-2 lg:gap-16 lg:py-24">
    <div class:list={[reverse ? 'lg:order-2' : 'lg:order-1']}>
      {
        eyebrow ? (
          <SectionHead kicker={eyebrow} title={title} tone={tone === 'dark' ? 'dark' : 'light'} />
        ) : (
          <h2 class:list={['font-display text-3xl font-bold uppercase leading-[0.98] tracking-tight sm:text-4xl', titleColor]}>
            {title}
          </h2>
        )
      }
      <div class="rule-dim mt-4 w-20 text-orange-500" aria-hidden="true"></div>
      <div class:list={['mt-6 max-w-prose space-y-4 text-lg leading-relaxed [&_a]:font-semibold [&_a]:text-orange-500 [&_a]:underline', bodyColor]}>
        <slot />
      </div>
      {
        bullets.length > 0 && (
          <ul class="mt-6 grid gap-3 sm:grid-cols-2">
            {bullets.map((b) => (
              <li class:list={['flex items-start gap-2.5', bodyColor]}>
                <Icon name="check" class="mt-0.5 h-5 w-5 flex-shrink-0 text-orange-500" />
                <span>{b}</span>
              </li>
            ))}
          </ul>
        )
      }
      {
        cta && (
          <a href={cta.href} class="btn-primary mt-8">
            {cta.label}
          </a>
        )
      }
    </div>
    <div
      class:list={[
        'relative',
        reverse ? 'lg:order-1' : 'lg:order-2',
        !illustration && (reverse ? 'lg:ml-[calc(50%-50vw)]' : 'lg:mr-[calc(50%-50vw)]'),
      ]}
    >
      {illustration ? (
        <div>
          <div class="relative overflow-hidden border border-navy-600/20 bg-gradient-to-br from-navy-100 to-navy-200/60">
            <img src="/brand/mark-navy.svg" alt="" aria-hidden="true" class="pointer-events-none absolute -right-8 -top-8 w-40 opacity-[0.07]" />
            <img src={image} alt={imageAlt} width="1100" height="1100" loading="lazy" decoding="async" class="relative mx-auto aspect-square w-full max-w-md object-contain p-6" />
          </div>
          {specTag && <p class="spec-tag">{specTag}</p>}
        </div>
      ) : (
        <div>
          <img
            src={image}
            srcset={cardSrcset(image)}
            sizes="(min-width: 1024px) 55vw, 92vw"
            alt={imageAlt}
            width="1400"
            height="1050"
            loading="lazy"
            decoding="async"
            class="aspect-[4/3] w-full object-cover"
          />
          {specTag && <p class="spec-tag">{specTag}</p>}
        </div>
      )}
    </div>
  </div>
</section>
