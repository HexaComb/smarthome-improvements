---
import Icon from './Icon.astro';
import { cardSrcset } from '../lib/images';
import SectionHead from './SectionHead.astro';
import { site, reviews } from '../data/site';
import { projects } from '../data/projects';
interface Props {
  heading?: string;
  image?: string;
  imageAlt?: string;
}
const {
  heading = 'We have perfected the process',
  image = '/photos/projects/roof-hanford-lassen.jpg',
  imageAlt = 'Completed roofing project on a Central Valley home',
} = Astro.props;
const r = reviews[0];
// Spec tag for the photo, derived from real project data (never invented).
const proj = projects.find((p) => p.image === image);
const photoTag = proj ? `${proj.title} · ${proj.city}` : 'Completed project · Central Valley';
const steps = [
  { n: '1', title: 'Contact our team', text: 'Call or request a quote online. We respond promptly and consistently to every inquiry.' },
  { n: '2', title: 'Detailed inspection', text: 'We assess your home, identify the problem areas, and document everything with photos.' },
  { n: '3', title: 'Review your estimate', text: 'Clear, itemized, no-obligation pricing so you can decide with full confidence.' },
  { n: '4', title: 'Expert installation', text: 'Our licensed crew does the work cleanly, on schedule, and built to last.' },
];
---

<section class="section">
  <div class="container-x grid gap-12 lg:grid-cols-2 lg:gap-16">
    <div>
      <SectionHead no="03" kicker="Our process" title={heading}>
        <div class="rule-dim mt-4 w-20 text-orange-500" aria-hidden="true"></div>
      </SectionHead>
      <ol class="mt-8 space-y-6">
        {
          steps.map((s) => (
            <li class="relative border-b border-navy-600/15 pb-6 last:border-0">
              <span class="num-outline pointer-events-none absolute left-0 top-0 select-none" aria-hidden="true">
                0{s.n}
              </span>
              <div class="relative pl-24 sm:pl-28">
                <p class="kicker num text-orange-700">
                  Step {s.n}
                </p>
                <h3 class="font-display mt-1 text-xl font-bold uppercase tracking-tight text-navy-700">
                  {s.title}
                </h3>
                <p class="mt-1 text-slate-600">{s.text}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>

    <div class="relative">
      <img
        src={image}
        srcset={cardSrcset(image)}
        sizes="(min-width: 1024px) 45vw, 92vw"
        alt={imageAlt}
        width="1400"
        height="1050"
        loading="lazy"
        decoding="async"
        class="aspect-[4/5] w-full object-cover sm:aspect-[4/3] lg:aspect-[3/4]"
      />
      <p class="spec-tag">{photoTag}</p>
      <figure class="absolute -bottom-4 left-4 right-4 rounded-none border border-navy-600/20 bg-white p-5 shadow-none sm:left-6 sm:max-w-sm">
        <div class="flex items-center gap-2">
          <span class="font-display num text-lg font-bold text-navy-700">{site.rating.value}</span>
          <span class="flex text-orange-500" aria-hidden="true">
            {Array.from({ length: 5 }).map(() => <Icon name="star" class="h-4 w-4" />)}
          </span>
          <span class="ml-auto text-xs font-medium text-slate-500">Google review</span>
        </div>
        <blockquote class="mt-3 text-sm leading-relaxed text-slate-700">“{r.text}”</blockquote>
        <figcaption class="mt-2 text-sm font-semibold text-navy-900">
          {r.name} <span class="font-normal text-slate-500">, {r.city}</span>
        </figcaption>
      </figure>
    </div>
  </div>
</section>
