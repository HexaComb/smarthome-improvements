---
interface Props {
  name: string;
  class?: string;
}
const { name, class: cls = 'h-6 w-6' } = Astro.props;

// Heroicons-style stroke paths keyed by name.
const paths: Record<string, string> = {
  roof: 'M3 11.5 12 4l9 7.5M5 10v10h14V10M9 20v-6h6v6',
  window: 'M4 4h16v16H4zM12 4v16M4 12h16',
  insulation: 'M4 6h16M4 10h16M4 14h16M4 18h16',
  check: 'M5 13l4 4L19 7',
  phone:
    'M3 5a2 2 0 0 1 2-2h2l2 5-2.5 1.5a11 11 0 0 0 6 6L16 15l5 2v2a2 2 0 0 1-2 2A16 16 0 0 1 3 5z',
  shield: 'M12 3l8 3v6c0 5-3.4 8-8 9-4.6-1-8-4-8-9V6l8-3z',
  clock: 'M12 7v5l3 2M12 21a9 9 0 1 1 0-18 9 9 0 0 1 0 18z',
  star: 'M12 3l2.9 6 6.6.9-4.8 4.6 1.2 6.5L12 18l-5.9 3 1.2-6.5L2.5 9.9 9.1 9z',
  arrow: 'M5 12h14M13 6l6 6-6 6',
  leaf: 'M4 20s8-1 12-5 4-11 4-11-7 0-11 4-5 12-5 12z',
  dollar: 'M12 3v18M16 7a4 4 0 0 0-4-2c-2 0-4 1-4 3s2 3 4 3 4 1 4 3-2 3-4 3a4 4 0 0 1-4-2',
  wrench: 'M14 7a4 4 0 0 0-5 5l-6 6 2 2 6-6a4 4 0 0 0 5-5l-2 2-2-2 2-2z',
  map: 'M9 3 4 5v16l5-2 6 2 5-2V3l-5 2-6-2zM9 3v16M15 5v16',
  chat: 'M8 10h8M8 13.5h5M12 20a8 8 0 1 0-7.1-4.3L4 20l4.3-.9c1.1.6 2.4.9 3.7.9z',
};
const d = paths[name] ?? paths.check;
const filled = name === 'star';
---

{
  filled ? (
    <svg class={cls} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d={d} />
    </svg>
  ) : (
    <svg
      class={cls}
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.8"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d={d} />
    </svg>
  )
}
