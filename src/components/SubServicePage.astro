---
import Layout from '../layouts/Layout.astro';
import Icon from './Icon.astro';
import Reviews from './Reviews.astro';
import CtaBand from './CtaBand.astro';
import PageHero from './PageHero.astro';
import ProjectStrip from './ProjectStrip.astro';
import Honeypot from './Honeypot.astro';
import FormConsent from './FormConsent.astro';
import { site, services as navServices } from '../data/site';
import { projectsByService } from '../data/projects';
import { breadcrumbSchema, faqSchema, serviceSchema } from '../lib/schema';
import ResourceLinks from './ResourceLinks.astro';
import type { ServiceSlug } from '../data/blogMeta';
import type { ServiceContent, SubService } from '../data/serviceContent';

interface Props {
  service: ServiceContent;
  sub: SubService;
}
const { service, sub } = Astro.props;
const path = `/${service.slug}/${sub.slug}/`;
const siblings = service.children.filter((c) => c.slug !== sub.slug);
const proj = projectsByService(service.slug).slice(0, 3);
const formReady = site.formAccessKey.length > 0;

const crumbs = [
  { name: 'Home', path: '/' },
  { name: service.name, path: `/${service.slug}/` },
  { name: sub.name, path },
];

const schema = [
  serviceSchema({ name: `${sub.name} in ${site.city}, ${site.region}`, description: sub.metaDescription, path, image: sub.image }),
  faqSchema(sub.faqs),
  breadcrumbSchema(crumbs),
  {
    '@context': 'https://schema.org',
    '@type': 'ImageObject',
    contentUrl: new URL(sub.image, site.url).href,
    caption: sub.imageAlt,
  },
];
---

<Layout title={sub.metaTitle} description={sub.metaDescription} path={path} image={sub.image} schema={schema}>
  <PageHero
    image={sub.image}
    imageAlt={sub.imageAlt}
    crumbs={crumbs}
    title={sub.h1}
    intro={sub.intro}
    eager={true}
  >
    <a href="#quote" class="btn-primary">Get a Free Estimate</a>
    <a href={`tel:${site.phoneRaw}`} class="btn-secondary">
      <Icon name="phone" class="h-5 w-5" /> {site.phone}
    </a>
  </PageHero>

  <!-- Body + highlights -->
  <section class="section">
    <div class="container-x grid gap-12 lg:grid-cols-3">
      <div class="lg:col-span-2">
        {
          sub.body.map((b) => (
            <div class="mb-8">
              <h2 class="font-display text-2xl font-bold uppercase tracking-tight text-navy-700">
                {b.heading}
              </h2>
              <p class="mt-3 leading-relaxed text-slate-700">{b.text}</p>
            </div>
          ))
        }
        <a href="#quote" class="btn-primary mt-2">Request Your Free Quote</a>
      </div>
      <aside class="lg:col-span-1">
        <div class="rounded-none border border-navy-600/20 bg-navy-50 p-6">
          <h2 class="font-display text-lg font-bold uppercase tracking-tight text-navy-700">
            What you get
          </h2>
          <ul class="mt-4 space-y-3">
            {
              sub.highlights.map((h) => (
                <li class="flex items-start gap-3 text-slate-700">
                  <Icon name="check" class="mt-0.5 h-5 w-5 flex-shrink-0 text-orange-500" />
                  <span>{h}</span>
                </li>
              ))
            }
          </ul>
          <div class="mt-6 rounded-none bg-navy-700 p-4 text-center text-white">
            <p class="text-sm text-navy-100">Free estimates, no obligation</p>
            <a href={`tel:${site.phoneRaw}`} class="font-display mt-1 block text-xl font-bold">
              {site.phone}
            </a>
          </div>
        </div>
      </aside>
    </div>
  </section>

  {proj.length > 0 && (
    <ProjectStrip
      items={proj}
      eyebrow="Recent work"
      heading={`Recent ${service.name.toLowerCase()} projects`}
      sub={`${service.name} work we have completed for homeowners across the Central Valley.`}
    />
  )}

  <!-- Lead form (attributed to this sub-service) -->
  <section id="quote" class="scroll-mt-20 bg-navy-900 bg-blueprint grain text-white">
    <div class="container-x grid gap-8 py-12 lg:grid-cols-12 lg:items-center lg:gap-12 lg:py-16">
      <div class="lg:col-span-5">
        <p class="kicker text-orange-400">Free, no obligation</p>
        <h2 class="mt-2 font-display text-3xl font-bold uppercase leading-[0.98] tracking-tight sm:text-4xl">Get your free {sub.name.toLowerCase()} estimate</h2>
        <ul class="mt-6 space-y-2.5">
          {['A real person responds fast', 'Honest, upfront pricing', 'Licensed CA #' + site.license].map((b) => (
            <li class="flex items-center gap-2.5 text-navy-100">
              <Icon name="check" class="h-5 w-5 flex-shrink-0 text-orange-400" /> {b}
            </li>
          ))}
        </ul>
        <a href={`tel:${site.phoneRaw}`} class="num mt-7 inline-flex items-center gap-2 font-display text-2xl font-bold text-white hover:text-orange-300">
          <Icon name="phone" class="h-6 w-6 text-orange-400" /> {site.phone}
        </a>
      </div>
      <div class="order-first lg:order-none lg:col-span-7">
        <div class="rounded-none bg-white p-6 text-slate-800 shadow-2xl ring-1 ring-black/5 sm:p-7">
          <form method="POST" action="/api/lead/" class="grid gap-3">
            <input type="hidden" name="service_page" value={`${service.name} - ${sub.name}`} />
            <Honeypot />
            <div class="grid gap-3 sm:grid-cols-2">
              <input name="name" required aria-label="Full name" autocomplete="name" placeholder="Full name" class="w-full rounded-lg border border-slate-300 px-4 py-2.5 focus:border-navy-500 focus:outline-none focus:ring-2 focus:ring-navy-200" />
              <input name="phone" type="tel" required aria-label="Phone number" autocomplete="tel" inputmode="tel" pattern="[0-9()+\-. ]{10,}" title="Enter a 10 digit phone number" placeholder="Phone" class="w-full rounded-lg border border-slate-300 px-4 py-2.5 focus:border-navy-500 focus:outline-none focus:ring-2 focus:ring-navy-200" />
              <input name="email" type="email" aria-label="Email" autocomplete="email" placeholder="Email" class="w-full rounded-lg border border-slate-300 px-4 py-2.5 focus:border-navy-500 focus:outline-none focus:ring-2 focus:ring-navy-200" />
              <input name="zip" aria-label="ZIP code" autocomplete="postal-code" inputmode="numeric" pattern="[0-9]{5}(-[0-9]{4})?" title="Enter a 5 digit ZIP code" placeholder="ZIP code" class="w-full rounded-lg border border-slate-300 px-4 py-2.5 focus:border-navy-500 focus:outline-none focus:ring-2 focus:ring-navy-200" />
            </div>
            <div class="grid gap-3 sm:grid-cols-2">
              <input name="address" aria-label="Street address" autocomplete="street-address" placeholder="Street address" class="w-full rounded-lg border border-slate-300 px-4 py-2.5 focus:border-navy-500 focus:outline-none focus:ring-2 focus:ring-navy-200" />
              <input name="city" aria-label="City" autocomplete="address-level2" placeholder="City" class="w-full rounded-lg border border-slate-300 px-4 py-2.5 focus:border-navy-500 focus:outline-none focus:ring-2 focus:ring-navy-200" />
            </div>
            <select name="service" required aria-label="Service needed" class="w-full rounded-lg border border-slate-300 bg-white px-4 py-2.5 text-slate-800 invalid:text-slate-500 focus:border-navy-500 focus:outline-none focus:ring-2 focus:ring-navy-200">
              <option value={service.name} selected>{service.name}</option>
              {navServices.filter((s) => s.slug !== service.slug).map((s) => <option value={s.name}>{s.name}</option>)}
              <option value="Multiple / Other">Multiple / Other</option>
            </select>
            <textarea name="message" rows="3" aria-label="How can we help?" placeholder="How can we help?" class="w-full rounded-lg border border-slate-300 px-4 py-2.5 focus:border-navy-500 focus:outline-none focus:ring-2 focus:ring-navy-200"></textarea>
            <button type="submit" disabled={!formReady} class="btn-primary w-full disabled:cursor-not-allowed disabled:opacity-50">
              Request My Free Quote
            </button>
            <p class="text-center text-xs text-slate-500">Free and no obligation. We respond fast.</p>
            <FormConsent />
          </form>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section">
    <div class="container-x max-w-3xl">
      <h2 class="h-section text-center">{sub.name} FAQs</h2>
      <div class="mt-10 divide-y divide-navy-600/15 rounded-none border border-navy-600/25 bg-white">
        {
          sub.faqs.map((f) => (
            <details class="group p-5">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-navy-900">
                {f.q}
                <Icon name="arrow" class="h-5 w-5 flex-shrink-0 text-navy-500 transition group-open:rotate-90" />
              </summary>
              <p class="mt-3 text-slate-600">{f.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Related -->
  <section class="bg-slate-50 py-16">
    <div class="container-x">
      <h2 class="text-center font-display text-2xl font-bold uppercase tracking-tight text-navy-700">
        More {service.name.toLowerCase()} services
      </h2>
      <div class="mt-8 grid gap-6 sm:grid-cols-2">
        <a href={`/${service.slug}/`} class="group flex items-center gap-4 rounded-none border border-navy-600/20 bg-white p-6 transition hover:border-navy-600/50">
          <span class="grid h-12 w-12 place-items-center rounded-xl bg-navy-50 text-navy-700">
            <Icon name={service.icon} class="h-6 w-6" />
          </span>
          <span class="flex-1">
            <span class="block font-display text-lg font-bold uppercase tracking-tight text-navy-700">All {service.name}</span>
            <span class="block text-sm text-slate-500">Service overview</span>
          </span>
          <Icon name="arrow" class="h-5 w-5 text-navy-400 transition group-hover:translate-x-1" />
        </a>
        {
          siblings.map((s) => (
            <a href={`/${service.slug}/${s.slug}/`} class="group flex items-center gap-4 rounded-none border border-navy-600/20 bg-white p-6 transition hover:border-navy-600/50">
              <span class="grid h-12 w-12 place-items-center rounded-xl bg-navy-50 text-navy-700">
                <Icon name={service.icon} class="h-6 w-6" />
              </span>
              <span class="flex-1">
                <span class="block font-display text-lg font-bold uppercase tracking-tight text-navy-700">{s.name}</span>
                <span class="block text-sm text-slate-500">{s.short}</span>
              </span>
              <Icon name="arrow" class="h-5 w-5 text-navy-400 transition group-hover:translate-x-1" />
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <Reviews />
  <ResourceLinks service={service.slug as ServiceSlug} />

  <CtaBand heading={`Get your free ${sub.name.toLowerCase()} quote`} />
</Layout>
