---
// Company promise: the one thing homeowners complain about most with
// contractors (nobody answers) is the one thing we lead with. Call or text.
import Icon from './Icon.astro';
import { site } from '../data/site';

interface Props {
  tone?: 'light' | 'dark';
}
const { tone = 'light' } = Astro.props;
const dark = tone === 'dark';
---

<section class:list={['py-14', dark ? 'bg-navy-900 bg-blueprint grain text-white' : 'bg-navy-50 bg-blueprint-light']}>
  <div class="container-x flex flex-col items-start gap-6 lg:flex-row lg:items-center lg:justify-between">
    <div class="max-w-2xl">
      <p class:list={['kicker', dark ? 'text-orange-400' : 'text-orange-700']}>Our promise</p>
      <h2 class:list={['font-display mt-2 text-3xl font-bold uppercase leading-tight tracking-tight sm:text-4xl', dark ? 'text-white' : 'text-navy-900']}>
        A real person answers. <span class={dark ? 'text-orange-400' : 'text-orange-600'}>Every time.</span>
      </h2>
      <p class:list={['mt-4 text-lg', dark ? 'text-navy-100' : 'text-slate-700']}>
        Plenty of contractors are easy to reach until you have a question. Call us, text us, or send the
        form: you get a straight answer from someone who knows your job, before, during, and after the work.
      </p>
    </div>
    <div class="flex flex-shrink-0 flex-col gap-3 sm:flex-row">
      <a href={`tel:${site.phoneRaw}`} class="btn-primary">
        <Icon name="phone" class="h-5 w-5" /> Call {site.phone}
      </a>
      <a href={`sms:${site.smsRaw}`} class={dark ? 'btn-secondary' : 'btn-outline'}>
        <Icon name="check" class="h-5 w-5" /> Text us
      </a>
    </div>
  </div>
</section>
