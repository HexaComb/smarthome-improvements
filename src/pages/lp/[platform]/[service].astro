---
import LandingLayout from '../../../layouts/LandingLayout.astro';
import LandingForm from '../../../components/LandingForm.astro';
import InspectionExplorer from '../../../components/InspectionExplorer.astro';
import Reviews from '../../../components/Reviews.astro';
import StatsBand from '../../../components/StatsBand.astro';
import VideoGallery from '../../../components/VideoGallery.astro';
import YouTubeEmbed from '../../../components/YouTubeEmbed.astro';
import PhotoGallery from '../../../components/PhotoGallery.astro';
import Icon from '../../../components/Icon.astro';
import { site } from '../../../data/site';
import { serviceContent } from '../../../data/serviceContent';
import { platforms, adServices, landingCopy, offerFor } from '../../../data/landing';
import { videosFor, localVsl } from '../../../data/videos';
import { galleryByService } from '../../../data/gallery';
import { webpSrcset } from '../../../lib/images';

export function getStaticPaths() {
  return Object.values(platforms).flatMap((p) =>
    adServices.map((s) => ({ params: { platform: p.key, service: s }, props: { platform: p, service: s } }))
  );
}

const { platform, service } = Astro.props;
const data = serviceContent[service];
const copy = landingCopy(platform.key, service);
const offer = offerFor[service];
const phone = platform.phoneByService?.[service] ?? platform.phone;
// LandingLayout (header, sticky bar, footer) gets the same per-service number.
const platformForLayout = { ...platform, phone };

const title = `${copy.headline} | ${site.name}`;
const description = `${copy.sub}`.slice(0, 155);

const vsl = (videosFor(service)[0] ?? videosFor('brand')[0]);
const local = localVsl[service];
const proofVids = videosFor(service).length ? videosFor(service) : videosFor('brand');
const photos = galleryByService[service] ?? [];

const approach = [
  { icon: 'check', title: 'Free, thorough inspection', text: 'We assess your home and document everything with photos. You see exactly what we see.' },
  { icon: 'shield', title: 'Honest recommendations', text: 'Repair or replace, we tell you the truth for your home and budget. No scare tactics.' },
  { icon: 'clock', title: 'Clean, on-time work', text: 'Licensed crews, clear timelines, tidy job sites, and upfront pricing with no surprises.' },
];

const faqs = [
  { q: 'Is the inspection really free?', a: `Yes. The ${offer.inspectionName.toLowerCase()} and your buyer's guide are completely free, with no cost and no obligation to buy anything.` },
  { q: 'Will I get a hard sales pitch?', a: 'No. We inspect, show you what we find with photos, and give you honest options. If we are not the right fit, we will tell you.' },
  ...data.faqs.slice(0, 2),
];
---

<LandingLayout title={title} description={description} platform={platformForLayout} preloadImage={{ href: data.image.replace(".jpg", "-800.webp"), imagesrcset: webpSrcset(data.image), imagesizes: "100vw" }}>
  <!-- 1. HERO + OFFER -->
  <section class="relative overflow-hidden bg-navy-900 text-white">
    <img src={data.image} srcset={webpSrcset(data.image)} sizes="100vw" alt={data.imageAlt} width="2000" height="1333" fetchpriority="high" decoding="async" class="absolute inset-0 h-full w-full object-cover" />
    <div class="absolute inset-0 bg-gradient-to-r from-navy-900 via-navy-900/92 to-navy-900/65"></div>
    <div class="container-x relative grid items-start gap-10 py-12 lg:grid-cols-12 lg:py-16">
      <div class="lg:col-span-7">
        <div class="flex flex-wrap items-center gap-3">
          <span class="inline-flex items-center gap-1.5 rounded-full bg-white/10 px-3 py-1.5 text-sm font-semibold text-white ring-1 ring-white/20">
            <span class="flex text-orange-400" aria-hidden="true">
              {Array.from({ length: 5 }).map(() => <Icon name="star" class="h-4 w-4" />)}
            </span>
            {site.rating.value} from {site.rating.count} reviews
          </span>
          <span class="inline-flex items-center gap-1.5 rounded-full bg-white/10 px-3 py-1.5 text-sm font-semibold text-white ring-1 ring-white/20">
            <Icon name="shield" class="h-4 w-4 text-orange-400" /> Licensed CA #{site.license}
          </span>
        </div>
        <p class="kicker mt-5 text-orange-400">{copy.eyebrow}</p>
        <h1 class="font-display mt-2 text-4xl font-bold uppercase leading-[0.95] tracking-tight sm:text-5xl">{copy.headline}</h1>
        <div class="mt-4 h-1.5 w-24 rounded-full bg-orange-500"></div>
        <p class="mt-5 max-w-xl text-lg text-navy-100">{copy.sub}</p>
        <div class="mt-6 inline-flex items-center gap-2 rounded-lg bg-orange-500/15 px-4 py-2 ring-1 ring-orange-400/40">
          <Icon name="check" class="h-5 w-5 text-orange-400" />
          <span class="font-display font-semibold uppercase tracking-wide text-white">{copy.offer}</span>
        </div>
        <ul class="mt-6 grid max-w-md gap-2">
          {[`${offer.inspectionName} (free)`, `Licensed CA #${site.license}`, `${site.rating.value} stars from ${site.rating.count} reviews`].map((b) => (
            <li class="flex items-center gap-2 font-display font-semibold uppercase tracking-wide text-white">
              <Icon name="check" class="h-5 w-5 flex-shrink-0 text-orange-400" /> {b}
            </li>
          ))}
        </ul>
        <div class="mt-7 flex flex-col gap-3 sm:flex-row">
          <a href="#quote" class="btn-primary">{copy.cta}</a>
          <a href={`tel:${phone.raw}`} class="btn-secondary">
            <Icon name="phone" class="h-5 w-5" /> {phone.display}
          </a>
        </div>
        <a href={offer.guidePath} target="_blank" rel="noopener" class="mt-4 inline-flex items-center gap-2 text-sm text-navy-100 underline decoration-orange-400 underline-offset-4 hover:text-white">
          <Icon name="arrow" class="h-4 w-4" /> Prefer to read first? Download the free guide
        </a>
      </div>
      <div class="lg:col-span-5">
        <LandingForm platform={platform} serviceName={data.name} cta={copy.cta} id="quote" />
      </div>
    </div>
  </section>

  <!-- TRUST BAR -->
  <section class="border-b border-slate-100 bg-white">
    <div class="container-x flex flex-wrap items-center justify-center gap-x-8 gap-y-3 py-5 text-sm font-semibold text-navy-700">
      {[
        { icon: 'star', label: `${site.rating.value} Google rating` },
        { icon: 'shield', label: `Licensed CA #${site.license}` },
        { icon: 'check', label: 'Free, no-obligation inspection' },
        { icon: 'clock', label: `${site.yearsInBusiness}+ years, local & insured` },
      ].map((t) => (
        <span class="inline-flex items-center gap-2">
          <Icon name={t.icon} class="h-5 w-5 text-orange-500" /> {t.label}
        </span>
      ))}
    </div>
  </section>

  <StatsBand />

  <!-- 2. VSL -->
  {(local || vsl) && (
    <section class="section bg-white">
      <div class="container-x grid items-center gap-10 lg:grid-cols-2">
        <div>
          <p class="kicker text-orange-700">Watch this first</p>
          <h2 class="h-section mt-2">See why homeowners choose us</h2>
          <p class="mt-4 text-slate-600">
            Take 60 seconds to see real {data.name.toLowerCase()} work and hear from a Central Valley homeowner. Then claim your free inspection while spots last.
          </p>
          <ul class="mt-6 grid gap-2">
            {['Real jobs, real customers', 'Licensed, local, and reviewed', 'No pressure, ever'].map((b) => (
              <li class="flex items-center gap-2 text-slate-700"><Icon name="check" class="h-5 w-5 text-orange-500" /> {b}</li>
            ))}
          </ul>
          <a href="#quote" class="btn-primary mt-7">{copy.cta}</a>
        </div>
        {local ? (
          <div class:list={[local.vertical && 'mx-auto w-full max-w-[20rem]']}>
            <video
              controls
              preload="none"
              playsinline
              poster={local.poster}
              class:list={[
                'w-full rounded-none border border-navy-600/20 bg-navy-950 object-cover',
                local.vertical ? 'aspect-[9/16]' : 'aspect-video',
              ]}
              title={local.title}
            >
              <source src={local.src} type="video/mp4" />
            </video>
            {local.transcript && (
              <details class="mt-3 text-sm text-slate-600">
                <summary class="cursor-pointer font-semibold text-navy-700">Read the video transcript</summary>
                <p class="mt-2 max-w-prose">{local.transcript}</p>
              </details>
            )}
          </div>
        ) : (
          <div class="mx-auto w-full max-w-[20rem]">
            <YouTubeEmbed id={vsl.id} title={vsl.title} vertical={true} />
          </div>
        )}
      </div>
    </section>
  )}

  <!-- 3. PROBLEM / AGITATION -->
  <section class="relative overflow-hidden bg-navy-900 py-16 text-white sm:py-20">
    <img src="/brand/mark-white.svg" alt="" aria-hidden="true" class="pointer-events-none absolute -left-16 top-1/2 hidden w-80 -translate-y-1/2 opacity-[0.04] lg:block" />
    <div class="container-x relative">
      <div class="mx-auto max-w-2xl text-center">
        <p class="kicker text-orange-400">Read this before you hire anyone</p>
        <h2 class="font-display mt-2 text-3xl font-bold uppercase sm:text-4xl">The wrong choice is expensive</h2>
      </div>
      <div class="mt-12 grid gap-6 md:grid-cols-3" data-stagger>
        {offer.problems.map((p, i) => (
          <div class="lift rounded-2xl bg-white/5 p-6 ring-1 ring-white/10 hover:bg-white/10">
            <span class="font-display grid h-11 w-11 place-items-center rounded-xl bg-orange-500 text-lg font-bold text-white">
              {i + 1}
            </span>
            <h3 class="font-display mt-4 text-lg font-bold uppercase tracking-tight text-white">{p.title}</h3>
            <p class="mt-2 text-sm text-navy-100">{p.text}</p>
          </div>
        ))}
      </div>
      <p class="mx-auto mt-8 max-w-2xl text-center text-navy-100">
        That is exactly why we start every job with a free, no-pressure inspection, so you know the truth before you spend a dollar.
      </p>
    </div>
  </section>

  <!-- 4. MECHANISM: interactive inspection explorer -->
  <InspectionExplorer
    fallback={data.featureIllustration ?? data.heroIllustration ?? data.image}
    inspectionName={offer.inspectionName}
    serviceName={data.name}
    points={offer.inspect}
  />

  <!-- 4b. Our honest, no-pressure promise -->
  <section class="bg-slate-50 py-14">
    <div class="container-x grid gap-6 md:grid-cols-3" data-stagger>
      {approach.map((a) => (
        <div class="lift rounded-2xl border border-slate-200 bg-white p-7 hover:border-orange-300 hover:shadow-lg">
          <span class="grid h-12 w-12 place-items-center rounded-xl bg-navy-50 text-navy-700"><Icon name={a.icon} class="h-6 w-6" /></span>
          <h3 class="font-display mt-4 text-lg font-bold uppercase tracking-tight text-navy-700">{a.title}</h3>
          <p class="mt-2 text-slate-600">{a.text}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- 5. STACKED PROOF -->
  <Reviews />
  {proofVids.length > 0 && (
    <VideoGallery items={proofVids} tone="dark" heading="See us in action" sub="Real jobs and customer testimonials. Tap to watch." />
  )}
  {photos.length > 0 && (
    <PhotoGallery items={photos} tone="muted" heading={`Real ${data.name.toLowerCase()} jobs`} sub="A look at our recent work across the Central Valley." />
  )}

  <!-- 6. THE OFFER STACK -->
  <section class="section bg-white">
    <div class="container-x grid items-center gap-12 lg:grid-cols-2 lg:gap-16">
      <div>
        <p class="kicker text-orange-700">Here is everything you get</p>
        <h2 class="h-section mt-2">Your free {data.name.toLowerCase()} package</h2>
        <p class="mt-4 text-slate-600">A real, itemized value, yours at no cost when you book your free inspection. No strings, no pressure to buy anything.</p>
        {data.heroIllustration && (
          <div class="relative mt-8 hidden overflow-hidden rounded-3xl bg-gradient-to-br from-navy-800 to-navy-950 p-8 ring-1 ring-navy-200/20 lg:block">
            <img src="/brand/mark-white.svg" alt="" aria-hidden="true" class="pointer-events-none absolute -right-8 -top-8 w-44 opacity-[0.06]" />
            <img src={data.heroIllustration} alt="" aria-hidden="true" class="relative mx-auto w-full max-w-sm drop-shadow-2xl" />
          </div>
        )}
      </div>
      <div>
        <div class="reveal overflow-hidden rounded-2xl border border-slate-200 shadow-xl">
          {offer.valueStack.map((v) => (
            <div class="flex items-center justify-between gap-4 border-b border-slate-100 px-5 py-4 last:border-0">
              <span class="flex items-center gap-3 text-slate-700">
                <Icon name="check" class="h-5 w-5 flex-shrink-0 text-orange-500" /> {v.item}
              </span>
              <span class="font-display font-bold text-navy-700">{v.value}</span>
            </div>
          ))}
          <div class="flex items-center justify-between gap-4 bg-slate-50 px-5 py-4">
            <span class="font-display font-bold uppercase tracking-wide text-navy-700">Total value</span>
            <span class="font-display text-lg font-bold text-slate-400 line-through">{offer.totalValue}</span>
          </div>
          <div class="flex items-center justify-between gap-4 bg-navy-700 px-5 py-5 text-white">
            <span class="font-display text-xl font-bold uppercase tracking-wide">Today</span>
            <span class="font-display text-3xl font-bold text-orange-400">FREE</span>
          </div>
        </div>
        <a href="#quote" class="btn-primary mt-8 w-full">{copy.cta}</a>
        <p class="mt-3 text-center text-sm text-slate-500">No cost. No obligation. No pressure.</p>
      </div>
    </div>
  </section>

  <!-- 7. GUARANTEE / RISK REVERSAL -->
  <section class="bg-navy-900 py-16 text-white sm:py-20">
    <div class="container-x max-w-3xl text-center">
      <span class="mx-auto grid h-16 w-16 place-items-center rounded-full bg-orange-500 text-white shadow-lg"><Icon name="shield" class="h-8 w-8" /></span>
      <h2 class="font-display mt-5 text-3xl font-bold uppercase sm:text-4xl">Our get-it-right guarantee</h2>
      <p class="mt-4 text-lg text-navy-100">
        We stand behind every job. Licensed CA #{site.license}, clean job sites, and honest, upfront pricing. If something is not right, we make it right. And if we are not the best fit for your home, we will tell you, no pressure.
      </p>
    </div>
  </section>

  <!-- 8. URGENCY -->
  <section class="bg-orange-500 py-8 text-navy-950">
    <div class="container-x flex flex-col items-center justify-between gap-4 text-center sm:flex-row sm:text-left">
      <p class="font-display text-lg font-bold uppercase tracking-wide">
        We take a limited number of free inspections each month. Spots are filling up.
      </p>
      <a href="#quote" class="btn inline-flex flex-shrink-0 bg-white text-orange-700 hover:bg-navy-50">{copy.cta}</a>
    </div>
  </section>

  <!-- 9. FAQ -->
  <section class="section">
    <div class="container-x max-w-3xl">
      <h2 class="h-section text-center">Questions? Answered.</h2>
      <div class="mt-10 divide-y divide-slate-200 rounded-2xl border border-slate-200">
        {faqs.map((f) => (
          <details class="group p-5">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-navy-900">
              {f.q}
              <Icon name="arrow" class="h-5 w-5 flex-shrink-0 text-navy-500 transition group-open:rotate-90" />
            </summary>
            <p class="mt-3 text-slate-600">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- 10. FINAL CTA -->
  <section class="relative overflow-hidden bg-navy-900 py-16 text-white sm:py-20">
    <img src={data.image.replace(/\.jpg$/, '-800.webp')} alt="" aria-hidden="true" loading="lazy" decoding="async" class="absolute inset-0 h-full w-full object-cover opacity-30" />
    <div class="absolute inset-0 bg-navy-900/80"></div>
    <div class="container-x relative grid items-center gap-10 lg:grid-cols-2">
      <div>
        <p class="kicker text-orange-400">{copy.offer}</p>
        <h2 class="font-display mt-2 text-4xl font-bold uppercase leading-[0.95] sm:text-5xl">Claim your free {data.name.toLowerCase()} inspection</h2>
        <p class="mt-4 max-w-lg text-lg text-navy-100">Takes a minute. Call now or request below and a licensed local team will get right back to you.</p>
        <a href={`tel:${phone.raw}`} class="font-display mt-6 inline-flex items-center gap-2 text-3xl font-bold text-white">
          <Icon name="phone" class="h-7 w-7 text-orange-400" /> {phone.display}
        </a>
      </div>
      <LandingForm platform={platform} serviceName={data.name} cta={copy.cta} id="quote-2" />
    </div>
  </section>
</LandingLayout>
