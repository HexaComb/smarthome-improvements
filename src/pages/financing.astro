---
// Financing: honest process page. We have no approved lender terms to publish,
// so this page states only what is true: financing is available on approved
// credit through the lending partners in our proposal process, options are
// presented at the free in-home estimate, and homeowners see real numbers in
// writing before signing anything. No APRs, no payment examples, no lender names.
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Icon from '../components/Icon.astro';
import PromiseBand from '../components/PromiseBand.astro';
import CtaBand from '../components/CtaBand.astro';
import { site } from '../data/site';
import { breadcrumbSchema, faqSchema } from '../lib/schema';

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Financing', path: '/financing/' },
];

const steps = [
  {
    title: 'Get your free estimate',
    text: 'Start with the instant estimate tool for a price range in about a minute, or book the free in-home estimate. Either way it costs nothing and obligates you to nothing.',
  },
  {
    title: 'See your price',
    text: 'After we measure and inspect, you get an exact written price for your project. The number is the number, whether you finance or not.',
  },
  {
    title: 'Review financing options in-home',
    text: 'If financing helps, we pull up the options available to you on approved credit through the lending partners we work with in our proposal process. You see real numbers, in writing, at your kitchen table.',
  },
  {
    title: 'Pick what fits your budget',
    text: 'Choose an option, pay another way, or take time to think it over. Nothing moves forward until you say so.',
  },
];

const expect = [
  {
    icon: 'shield',
    title: 'The paperwork, walked through',
    text: 'Before you sign, we go through the documents with you and point out the parts people skip: the payment schedule, any fees, and what the paperwork says about paying it off early. If something is not clear, we slow down until it is.',
  },
  {
    icon: 'check',
    title: 'No pressure to finance',
    text: 'Financing is one way to pay, not a requirement. Your written price stands either way, whether you finance or pay another way.',
  },
  {
    icon: 'phone',
    title: 'Ask us anything',
    text: `A real person answers when you call or text ${site.phone}. Bring your questions about the numbers, the timeline, or the fine print, and you get a straight answer from someone who knows your job.`,
  },
];

const faqs = [
  {
    q: 'Do you offer financing?',
    a: 'Yes. Financing is available on approved credit through the lending partners we work with in our proposal process. We present the options during your free in-home estimate, and you see real numbers in writing before you sign anything.',
  },
  {
    q: 'What will my monthly payment be?',
    a: 'It depends on your project price, your credit, and the option you choose, so we do not publish payment examples. Any number printed on a website would be a guess about your situation. At the in-home estimate you see the actual options you qualify for, in writing, and you decide from there.',
  },
  {
    q: 'What does a project cost before financing?',
    a: 'Our instant estimate tool gives you a price range for windows and roofing before you enter any contact info. As a reference, quality vinyl dual-pane Low-E windows run $750 to $1,500 per window installed, and architectural shingle roofing runs $400 to $700 per roofing square (100 sq ft) installed, including tear-off of one layer. Your exact written price comes from the free in-home estimate.',
  },
  {
    q: 'What if my credit is not perfect?',
    a: 'Options vary by credit and by project, so the honest answer is: it depends. The in-home visit is where you find out what you actually qualify for. Looking at the options commits you to nothing, and if financing is not a fit, the estimate is still free and the price still stands.',
  },
  {
    q: 'Do I need financing to get an estimate?',
    a: 'No. The estimate is free whether you finance, pay another way, or just want to know where your project stands. It is a good way to plan a project for next season, whether you are in Fresno, Madera, or Visalia.',
  },
  {
    q: 'Will there be surprises in the paperwork?',
    a: 'Our job is to make sure there are none. We walk through the documents with you before you sign, point out the payment schedule and any fees, and answer every question in plain language. You keep copies of everything, and nothing starts until you have real numbers in writing.',
  },
];

const schema = [breadcrumbSchema(crumbs), faqSchema(faqs)];
---

<Layout
  title="Financing Your Roof, Windows or Insulation | Fresno, CA"
  description="Financing on approved credit through our lending partners. Real numbers in writing at your free in-home estimate, in Fresno and the Central Valley."
  path="/financing/"
  schema={schema}
>
  <section class="relative overflow-hidden bg-navy-900 bg-blueprint grain text-white">
    <div class="container-x relative py-12 lg:py-16">
      <Breadcrumbs items={crumbs} light={true} />
      <p class="kicker mt-6 text-orange-400">Financing your project</p>
      <h1 class="h-hero mt-2">Real numbers, in writing,<br /><span class="text-orange-400">before you sign anything.</span></h1>
      <div class="rule-dim mt-5 w-24 text-orange-500" aria-hidden="true"></div>
      <p class="mt-6 max-w-2xl text-lg text-navy-100">
        A failing roof or single-pane windows rarely wait for a convenient month. Financing is
        available on approved credit through the lending partners we work with, and the options
        are presented at your free in-home estimate, with real numbers, not teaser math.
      </p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a href="/estimate/" class="btn-primary">See Your Price Range</a>
        <a href={`tel:${site.phoneRaw}`} class="btn-secondary">
          <Icon name="phone" class="h-5 w-5" /> Call {site.phone}
        </a>
      </div>
    </div>
    <div class="rule-dim text-navy-200/40" aria-hidden="true"></div>
  </section>

  <section class="section">
    <div class="container-x">
      <p class="kicker text-orange-700">How it works</p>
      <h2 class="h-section mt-2">Four steps, no surprises</h2>
      <p class="mt-4 max-w-2xl text-slate-700">
        Fresno sits in California Climate Zone 13, and summer PG&amp;E bills prove it. The projects
        that fight that heat, a cool roof, efficient windows, real attic insulation, are exactly the
        ones that are hard to put off. Here is how paying for one actually works with us.
      </p>
      <div class="mt-10 grid gap-6 sm:grid-cols-2">
        {
          steps.map((s, i) => (
            <div class="rounded-2xl bg-slate-50 p-6">
              <span class="sheet-no" aria-hidden="true">0{i + 1}</span>
              <h3 class="mt-3 font-display text-xl font-bold uppercase tracking-tight text-navy-900">{s.title}</h3>
              <p class="mt-2 text-sm text-slate-600">{s.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section bg-navy-50 bg-blueprint-light">
    <div class="container-x">
      <p class="kicker text-orange-700">What to expect</p>
      <h2 class="h-section mt-2">How we handle the money conversation</h2>
      <div class="mt-10 grid gap-6 lg:grid-cols-3">
        {
          expect.map((e) => (
            <div class="rounded-2xl bg-white p-6 shadow-sm ring-1 ring-slate-100">
              <span class="grid h-12 w-12 place-items-center rounded-xl bg-navy-50 text-navy-700">
                <Icon name={e.icon} class="h-6 w-6" />
              </span>
              <h3 class="mt-4 font-bold text-navy-900">{e.title}</h3>
              <p class="mt-2 text-sm text-slate-600">{e.text}</p>
            </div>
          ))
        }
      </div>
      <div class="mt-10 rounded-2xl border-l-4 border-orange-500 bg-white p-6 shadow-sm">
        <h3 class="font-display text-xl font-bold uppercase tracking-tight text-navy-900">Why there are no rates on this page</h3>
        <p class="mt-2 max-w-prose text-slate-700">
          You will not find APRs, term lengths, or monthly payment examples here, because those
          depend on your credit, your project, and the option you choose. Any figure we printed
          would be a guess about your situation, and we do not guess in writing. What you get
          instead: a free estimate, an exact project price, and the financing options you actually
          qualify for, all on paper before you commit to anything. CSLB License #{site.license}.
        </p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container-x max-w-3xl">
      <p class="kicker text-orange-700">Financing FAQ</p>
      <h2 class="h-section mt-2">Straight answers about paying for your project</h2>
      <div class="mt-6 divide-y divide-navy-600/10 border-y border-navy-600/15">
        {
          faqs.map((f) => (
            <details class="group py-4">
              <summary class="flex cursor-pointer list-none items-start justify-between gap-4 font-semibold text-navy-800">
                {f.q}
                <Icon name="arrow" class="mt-1 h-4 w-4 flex-shrink-0 rotate-90 text-orange-500 transition-transform group-open:-rotate-90" />
              </summary>
              <p class="mt-2 max-w-prose text-slate-600">{f.a}</p>
            </details>
          ))
        }
      </div>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a href="/estimate/" class="btn-primary">Get an Instant Price Range</a>
        <a href="/contact/" class="btn-outline">Book a Free In-Home Estimate</a>
      </div>
    </div>
  </section>

  <PromiseBand />
  <CtaBand
    heading="Ready to see your numbers?"
    sub="Get a free estimate, an exact written price, and the financing options that fit. No obligation, no guessing."
  />
</Layout>
