---
// Resources hub: every free homeowner tool in one place. The three buyer's
// guide PDFs stay ungated (direct links); the compact form is an optional
// email capture that tags "Website - Guide Download" so we know which guide
// a homeowner asked for. Cost guides, the instant estimate tool, the FAQ,
// and the financing page round it out.
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Icon from '../components/Icon.astro';
import Honeypot from '../components/Honeypot.astro';
import PromiseBand from '../components/PromiseBand.astro';
import CtaBand from '../components/CtaBand.astro';
import { site } from '../data/site';
import { adServices, offerFor } from '../data/landing';
import { breadcrumbSchema } from '../lib/schema';

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Resources', path: '/resources/' },
];
const schema = [breadcrumbSchema(crumbs)];

const cap = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);
const guides = adServices.map((s) => ({
  service: cap(s),
  icon: s === 'roofing' ? 'roof' : s === 'windows' ? 'window' : 'insulation',
  title: offerFor[s].guideTitle,
  path: offerFor[s].guidePath,
}));

const costGuides = [
  {
    title: 'Roof Replacement Cost in Fresno and Clovis: What We Actually Charge',
    href: '/blog/roof-replacement-cost-fresno/',
    text: 'Real prices per square by material, whole-roof ranges by home size, tear-off vs overlay, and Title 24 cool roof rules.',
  },
  {
    title: 'What Window Replacement Actually Costs in Fresno (2026 Guide)',
    href: '/blog/window-replacement-cost-fresno/',
    text: 'Cost per window, whole-home ranges, retrofit vs full-frame, and what moves the price up or down.',
  },
];

const tools = [
  {
    icon: 'dollar',
    title: 'Instant estimate tool',
    href: '/estimate/',
    text: 'An honest Fresno price bracket for windows or a new roof in about a minute. The range shows before we ask for anything.',
    cta: 'Price my project',
  },
  {
    icon: 'chat',
    title: 'FAQ',
    href: '/faq/',
    text: 'Straight answers about roofing, windows, and insulation: costs, permits, timelines, warranties, and what to expect.',
    cta: 'Read the answers',
  },
  {
    icon: 'shield',
    title: 'Financing',
    href: '/financing/',
    text: 'How financing works here: available on approved credit, options presented at the free in-home estimate, real numbers in writing before you sign.',
    cta: 'See how it works',
  },
];

const formReady = site.formAccessKey.length > 0;
const inputCls =
  'w-full rounded-none border border-navy-600/20 px-4 py-2.5 focus:border-navy-500 focus:outline-none focus:ring-2 focus:ring-navy-200';
---

<Layout
  title="Free Guides, Cost Data & Tools for Fresno Homeowners"
  description="Free buyer's guides, real Fresno cost guides, an instant estimate tool, FAQs, and financing info for roofing, windows, and insulation. No forms required to download."
  path="/resources/"
  schema={schema}
>
  <section class="relative overflow-hidden bg-navy-900 bg-blueprint grain text-white">
    <div class="container-x relative py-12 lg:py-16">
      <Breadcrumbs items={crumbs} light={true} />
      <p class="kicker mt-6 text-orange-400">Free resources</p>
      <h1 class="h-hero mt-2">Do your homework.<br /><span class="text-orange-400">We did it for you.</span></h1>
      <div class="rule-dim mt-5 w-24 text-orange-500" aria-hidden="true"></div>
      <p class="mt-6 max-w-2xl text-lg text-navy-100">
        Everything we give homeowners before they spend a dollar: the buyer's guides, the real cost numbers,
        the instant estimate tool, and straight answers. No forms required to download anything.
      </p>
    </div>
    <div class="rule-dim text-navy-200/40" aria-hidden="true"></div>
  </section>

  <!-- 01 · Buyer's guides -->
  <section class="section">
    <div class="container-x">
      <div class="flex items-center gap-3">
        <span class="sheet-no" aria-hidden="true">01</span>
        <h2 class="font-display text-3xl font-bold uppercase tracking-tight text-navy-900">Free buyer's guides</h2>
      </div>
      <p class="mt-3 max-w-2xl text-slate-600">
        The same guides we hand out with every free inspection. Download them directly, no email needed.
      </p>
      <div class="mt-8 grid gap-10 lg:grid-cols-12">
        <ul class="space-y-3 lg:col-span-7">
          {guides.map((g) => (
            <li>
              <a
                href={g.path}
                target="_blank"
                rel="noopener"
                class="crops flex items-center gap-4 border border-navy-600/20 bg-white p-4 transition hover:border-navy-600/60"
              >
                <span class="grid h-11 w-11 flex-shrink-0 place-items-center border border-navy-600/20 bg-navy-50 text-navy-700">
                  <Icon name={g.icon} class="h-5 w-5" />
                </span>
                <span>
                  <span class="block font-display text-lg font-bold uppercase tracking-tight text-navy-800">{g.title}</span>
                  <span class="kicker num text-navy-500">{g.service} <span class="text-navy-200">·</span> Free PDF</span>
                </span>
                <Icon name="arrow" class="ml-auto h-5 w-5 flex-shrink-0 text-orange-500" />
              </a>
            </li>
          ))}
        </ul>

        <!-- Optional email copy: guides stay ungated; this just sends a copy. -->
        <div class="lg:col-span-5">
          <div class="border border-navy-600/20 bg-navy-50 bg-blueprint-light p-6">
            <p class="kicker text-orange-700">Optional</p>
            <h3 class="font-display mt-1 text-2xl font-bold uppercase tracking-tight text-navy-800">Want a copy by email?</h3>
            <p class="mt-1 text-sm text-slate-600">
              Tell us which guide and we send it over. No obligation, and the downloads above work either way.
            </p>
            {!formReady && (
              <p class="mt-4 border border-orange-200 bg-orange-50 p-3 text-xs text-orange-700">
                Form is being configured. Call or text us at {site.phone}.
              </p>
            )}
            <form method="POST" action="/api/lead/" class="mt-4 grid gap-3">
              <input type="hidden" name="lead_source" value="Website - Guide Download" />
              <input type="hidden" name="service" id="guide-service" value="" />
              <Honeypot />
              <label class="block text-sm font-medium text-slate-700"
                >Which guide?
                <select id="guide-select" name="message" class:list={[inputCls, 'mt-1 bg-white']}>
                  {guides.map((g) => (
                    <option value={`Guide requested: ${g.title}`} data-service={g.service}>{g.title}</option>
                  ))}
                </select>
              </label>
              <label class="block text-sm font-medium text-slate-700"
                >Full name
                <input name="name" required autocomplete="name" class:list={[inputCls, 'mt-1 bg-white']} />
              </label>
              <label class="block text-sm font-medium text-slate-700"
                >Email
                <input name="email" type="email" required autocomplete="email" class:list={[inputCls, 'mt-1 bg-white']} />
              </label>
              <button type="submit" disabled={!formReady} class="btn-primary w-full disabled:cursor-not-allowed disabled:opacity-50">
                Email Me the Guide
              </button>
              <!-- Email-only capture: no phone is collected, so the SMS consent
                   checkboxes (FormConsent) would reference a number that is never
                   provided. /api/lead/ defaults to no-sms-consent + SMS DND when
                   the box is absent, so the privacy/terms line alone is correct. -->
              <p class="text-[0.7rem] leading-relaxed text-slate-600">
                Please see our&nbsp;<a href="/privacy/" class="text-navy-700 underline hover:text-navy-900">Privacy Policy</a>&nbsp;and&nbsp;<a
                  href="/terms/"
                  class="text-navy-700 underline hover:text-navy-900">Terms of Service</a>.
              </p>
            </form>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 02 · Cost guides -->
  <section class="section bg-navy-50 bg-blueprint-light">
    <div class="container-x">
      <div class="flex items-center gap-3">
        <span class="sheet-no" aria-hidden="true">02</span>
        <h2 class="font-display text-3xl font-bold uppercase tracking-tight text-navy-900">Real cost guides</h2>
      </div>
      <p class="mt-3 max-w-2xl text-slate-600">
        The numbers we actually charge, published. The instant estimate tool below runs on the same figures.
      </p>
      <div class="mt-8 grid gap-6 md:grid-cols-2">
        {costGuides.map((c) => (
          <a href={c.href} class="crops block border border-navy-600/20 bg-white p-6 transition hover:border-navy-600/60">
            <p class="kicker text-navy-500">Cost guide</p>
            <h3 class="font-display mt-2 text-xl font-bold uppercase tracking-tight text-navy-800">{c.title}</h3>
            <p class="mt-2 text-sm text-slate-600">{c.text}</p>
            <span class="mt-4 inline-flex items-center gap-2 text-sm font-semibold text-navy-700">
              Read the guide <Icon name="arrow" class="h-4 w-4 text-orange-500" />
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- 03 · Tools & answers -->
  <section class="section">
    <div class="container-x">
      <div class="flex items-center gap-3">
        <span class="sheet-no" aria-hidden="true">03</span>
        <h2 class="font-display text-3xl font-bold uppercase tracking-tight text-navy-900">Tools & straight answers</h2>
      </div>
      <div class="mt-8 grid gap-6 md:grid-cols-3">
        {tools.map((t) => (
          <a href={t.href} class="crops flex flex-col border border-navy-600/20 bg-white p-6 transition hover:border-navy-600/60">
            <span class="grid h-11 w-11 place-items-center border border-navy-600/20 bg-navy-50 text-navy-700">
              <Icon name={t.icon} class="h-5 w-5" />
            </span>
            <h3 class="font-display mt-4 text-xl font-bold uppercase tracking-tight text-navy-800">{t.title}</h3>
            <p class="mt-2 flex-1 text-sm text-slate-600">{t.text}</p>
            <span class="mt-4 inline-flex items-center gap-2 text-sm font-semibold text-navy-700">
              {t.cta} <Icon name="arrow" class="h-4 w-4 text-orange-500" />
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <PromiseBand />
  <CtaBand heading="Rather talk it through with a person?" />

  <script is:inline>
    // Keep the hidden service field in sync with the selected guide so the
    // lead routes to the matching pipeline. No-JS fallback: service stays
    // blank and the lead lands in the catch-all pipeline, still tagged
    // "Website - Guide Download" with the guide named in the message.
    (function () {
      var sel = document.getElementById('guide-select');
      var svc = document.getElementById('guide-service');
      if (!sel || !svc) return;
      var sync = function () {
        var opt = sel.options[sel.selectedIndex];
        svc.value = (opt && opt.getAttribute('data-service')) || '';
      };
      sel.addEventListener('change', sync);
      sync();
    })();
  </script>
</Layout>
