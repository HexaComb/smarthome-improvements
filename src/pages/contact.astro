---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import PageHero from '../components/PageHero.astro';
import Honeypot from '../components/Honeypot.astro';
import FormConsent from '../components/FormConsent.astro';
import { site, services } from '../data/site';

const formReady = site.formAccessKey.length > 0;
---

<Layout
  title="Contact Us | Free Estimate in Fresno, CA"
  description="Request a free roofing, window, or insulation estimate from Smart Home Improvements in Fresno & the Central Valley. Call (559) 833-6945 or send us a message."
  path="/contact/"
>
  <PageHero
    image="/photos/hero/contact.jpg"
    imageAlt="Smart Home Improvements crew working on a Central Valley home"
    kicker="Contact us"
    title="Get your free estimate"
    intro="Tell us about your project and we'll get back to you fast with honest, upfront pricing. No obligation, ever."
    eager={true}
  />

  <section class="section">
    <div class="container-x grid gap-12 lg:grid-cols-5">
      <!-- Contact details -->
      <div class="lg:col-span-2">
        <h2 class="text-2xl font-bold text-navy-900">Reach us directly</h2>
        <ul class="mt-6 space-y-5">
          <li class="flex items-start gap-4">
            <span class="grid h-11 w-11 flex-shrink-0 place-items-center rounded-xl bg-navy-50 text-navy-700"><Icon name="phone" class="h-5 w-5" /></span>
            <span>
              <span class="block text-sm text-slate-500">Phone</span>
              <a href={`tel:${site.phoneRaw}`} class="text-lg font-semibold text-navy-900 hover:text-navy-700">{site.phone}</a>
            </span>
          </li>
          <li class="flex items-start gap-4">
            <span class="grid h-11 w-11 flex-shrink-0 place-items-center rounded-xl bg-navy-50 text-navy-700"><Icon name="check" class="h-5 w-5" /></span>
            <span>
              <span class="block text-sm text-slate-500">Email</span>
              <a href={`mailto:${site.email}`} class="text-lg font-semibold text-navy-900 hover:text-navy-700">{site.email}</a>
            </span>
          </li>
          <li class="flex items-start gap-4">
            <span class="grid h-11 w-11 flex-shrink-0 place-items-center rounded-xl bg-navy-50 text-navy-700"><Icon name="map" class="h-5 w-5" /></span>
            <span>
              <span class="block text-sm text-slate-500">Service area</span>
              <span class="text-lg font-semibold text-navy-900">{site.city}, {site.region}</span>
              <span class="block text-sm text-slate-500">Serving {site.areaServed}</span>
            </span>
          </li>
          <li class="flex items-start gap-4">
            <span class="grid h-11 w-11 flex-shrink-0 place-items-center rounded-xl bg-navy-50 text-navy-700"><Icon name="clock" class="h-5 w-5" /></span>
            <span>
              <span class="block text-sm text-slate-500">Hours</span>
              <ul class="mt-1 space-y-0.5 text-slate-700">
                {site.hours.map((h) => (
                  <li class="flex justify-between gap-6"><span>{h.days}</span><span class="text-slate-500">{h.time}</span></li>
                ))}
              </ul>
            </span>
          </li>
        </ul>
        <p class="mt-8 rounded-xl bg-navy-50 p-4 text-sm text-navy-900">
          Licensed California contractor, CA #{site.license}.
        </p>
      </div>

      <!-- Form -->
      <div class="lg:col-span-3">
        {
          !formReady && (
            <p class="mb-4 rounded-lg bg-orange-50 p-4 text-sm text-orange-700 ring-1 ring-orange-200">
              Form setup pending: add a free Web3Forms access key in
              <code class="font-mono">src/data/site.ts</code>. Meanwhile, call or
              email us using the details on this page.
            </p>
          )
        }
        <form
          method="POST"
          action="/api/lead/"
          class="rounded-2xl border border-slate-200 p-6 sm:p-8"
        >
          <input type="hidden" name="lead_source" value="Website - Contact page" />
          <!-- honeypot -->
          <Honeypot />

          <div class="grid gap-5 sm:grid-cols-2">
            <div class="sm:col-span-2">
              <label for="name" class="mb-1 block text-sm font-medium text-slate-700">Full name *</label>
              <input id="name" name="name" type="text" required autocomplete="name" class="w-full rounded-lg border border-slate-300 px-4 py-2.5 focus:border-navy-500 focus:outline-none focus:ring-2 focus:ring-navy-200" />
            </div>
            <div>
              <label for="phone" class="mb-1 block text-sm font-medium text-slate-700">Phone *</label>
              <input id="phone" name="phone" type="tel" required autocomplete="tel" inputmode="tel" pattern="[0-9()+\-. ]{10,}" title="Enter a 10 digit phone number" class="w-full rounded-lg border border-slate-300 px-4 py-2.5 focus:border-navy-500 focus:outline-none focus:ring-2 focus:ring-navy-200" />
            </div>
            <div>
              <label for="email" class="mb-1 block text-sm font-medium text-slate-700">Email</label>
              <input id="email" name="email" type="email" autocomplete="email" class="w-full rounded-lg border border-slate-300 px-4 py-2.5 focus:border-navy-500 focus:outline-none focus:ring-2 focus:ring-navy-200" />
            </div>
            <div>
              <label for="address" class="mb-1 block text-sm font-medium text-slate-700">Property address</label>
              <input id="address" name="address" type="text" autocomplete="street-address" class="w-full rounded-lg border border-slate-300 px-4 py-2.5 focus:border-navy-500 focus:outline-none focus:ring-2 focus:ring-navy-200" />
            </div>
            <div>
              <label for="city" class="mb-1 block text-sm font-medium text-slate-700">City</label>
              <input id="city" name="city" type="text" autocomplete="address-level2" class="w-full rounded-lg border border-slate-300 px-4 py-2.5 focus:border-navy-500 focus:outline-none focus:ring-2 focus:ring-navy-200" />
            </div>
            <div class="sm:col-span-2">
              <label for="service" class="mb-1 block text-sm font-medium text-slate-700">Service needed *</label>
              <select id="service" name="service" required class="w-full rounded-lg border border-slate-300 bg-white px-4 py-2.5 focus:border-navy-500 focus:outline-none focus:ring-2 focus:ring-navy-200">
                <option value="" disabled selected>Select a service…</option>
                {services.map((s) => <option value={s.name}>{s.name}</option>)}
                <option value="Multiple / Other">Multiple / Other</option>
              </select>
            </div>
            <div class="sm:col-span-2">
              <label for="message" class="mb-1 block text-sm font-medium text-slate-700">How can we help?</label>
              <textarea id="message" name="message" rows="4" class="w-full rounded-lg border border-slate-300 px-4 py-2.5 focus:border-navy-500 focus:outline-none focus:ring-2 focus:ring-navy-200"></textarea>
            </div>
          </div>

          <button
            type="submit"
            disabled={!formReady}
            class="btn-primary mt-6 w-full disabled:cursor-not-allowed disabled:opacity-50 sm:w-auto"
            >Request Free Estimate</button
          >
          <div class="mt-3">
            <FormConsent />
          </div>
        </form>
      </div>
    </div>
  </section>
</Layout>
