---
import Layout from '../../layouts/Layout.astro';
import CtaBand from '../../components/CtaBand.astro';
import Icon from '../../components/Icon.astro';
import PageHero from '../../components/PageHero.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---

<Layout
  title="Home Improvement Blog | Roofing, Windows & Insulation Tips"
  description="Expert roofing, window, and insulation tips for Central Valley homeowners from Smart Home Improvements. Learn how to protect your home and save on energy costs."
  path="/blog/"
>
  <PageHero
    imageAlt="Isometric illustration of a Central Valley home"
    illustration="/illustrations/home-hero.svg"
    kicker="Blog"
    title="Tips for a better home"
    intro="Practical roofing, window, and insulation advice tailored to Central Valley homes."
    eager={true}
  />

  <section class="section">
    <div class="container-x">
      <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
        {
          posts.map((post) => (
            <article class="flex flex-col rounded-2xl border border-slate-200 p-6 transition hover:shadow-lg">
              <span class="inline-flex w-fit rounded-full bg-navy-50 px-3 py-1 text-xs font-semibold text-navy-700">
                {post.data.category}
              </span>
              <h2 class="mt-4 text-xl font-bold text-navy-900">
                <a href={`/blog/${post.id}/`} class="hover:text-navy-700">
                  {post.data.title}
                </a>
              </h2>
              <p class="mt-3 flex-1 text-slate-600">{post.data.description}</p>
              <div class="mt-5 flex items-center justify-between text-sm">
                <time datetime={post.data.date.toISOString()} class="text-slate-500">
                  {fmt(post.data.date)}
                </time>
                <a href={`/blog/${post.id}/`} class="inline-flex items-center gap-1 font-semibold text-navy-700">
                  Read <Icon name="arrow" class="h-4 w-4" />
                </a>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <CtaBand />
</Layout>
