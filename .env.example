# Local development: no environment variables are required to render the site.
# Copy this file to .env and fill in only the integrations you use.

# GoHighLevel (forms, CRM sync, dashboard)
GHL_PIT=
GHL_LOCATION_ID=
GHL_BRIDGE_SECRET=

# JobNimbus CRM
JOBNIMBUS_API_KEY=

# Artemis proposals and contract sync
ARTEMIS_API_KEY=
ARTEMIS_WEBHOOK_SECRET=
# Optional override; defaults to https://sales-api.artemis.solar/external/v1
ARTEMIS_BASE=

# CallRail call lead sync
CALLRAIL_API_KEY=
CALLRAIL_ACCOUNT_ID=

# Meta Conversions API (server-side offline conversions)
META_CAPI_TOKEN=
META_PIXEL_ID=

# Live Google review rating at build time (optional)
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=

# Optional lead forwarding and internal alerts
ALIVO_WEBHOOK_URL=
DISCORD_WEBHOOK=

# Optional persistent cache/state. Use either the UPSTASH_* or KV_REST_API_* pair.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Protect internal dashboard/manual endpoints and scheduled jobs
DASH_KEY=
CRON_SECRET=

# Optional local Artemis backfill script progress file
PROGRESS_FILE=./backfill-progress.json
